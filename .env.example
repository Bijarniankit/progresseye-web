# ProgressEye Web — Environment Configuration Example
NODE_ENV=development
PORT=3000

# API Endpoints (Backend runs on port 4000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Server-only proxy target used in rewrites:
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public Lead Intake & Anti-Abuse (Phase 9)
# Set to "true" to connect public contact/demo/newsletter forms to API backend
NEXT_PUBLIC_HAS_LEAD_BACKEND=false
# Cloudflare Turnstile public site key (use official test key "1x00000000000000000000AA" for testing)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA


